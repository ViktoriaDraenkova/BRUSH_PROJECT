<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="style_for_toolbar" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="toolbar_style_white_text" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="SettingsButtonsStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginVertical">0dp</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:paddingHorizontal">32dp</item>
        <item name="android:textAlignment">textStart</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/dark_grey</item>
        <item name="iconGravity">end</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/blue_top</item>
    </style>

    <style name="ButtonStart">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="cornerRadius">54dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@color/blue_top</item>
        <item name="android:textSize">24sp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:background">@drawable/rounded_corners</item>
        <item name="android:layout_marginHorizontal">16dp</item>
<!--        <item name="android:paddingHorizontal">136dp</item>-->
        <item name="android:paddingVertical">16dp</item>
    </style>

    <style name="ButtonBlueText16White">
        <item name="cornerRadius">54dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:background">@drawable/enabled_disabled_btn</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextStyleBlue">
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:textColor">@color/blue_top</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="EdittextStyleWithDiscription">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">30dp</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:background">@drawable/rounded_corners__8dp_grey</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/light_grey</item>
        <item name="android:imeOptions">actionDone</item>
        <item name="android:inputType">text</item>
        <item name="android:maxLength">28</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/dark_grey_opacity60</item>
        <item name="android:textCursorDrawable">@drawable/cursor</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="font_style">
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="match_wrap">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="tabLayout" parent="match_wrap">
        <item name="android:background">#F5F5F5</item>
        <item name="tabTextAppearance">@style/font_style</item>
        <item name="tabTextColor">@color/black</item>
        <item name="tabIndicatorColor">@color/black</item>
        <item name="tabMode">fixed</item>
    </style>

    <style name="ButtonSecondary">
        <item name="android:textColor">@color/blue_top</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAlignment">center</item>
        <item name="android:paddingVertical">14dp</item>
    </style>

    <style name="ButtonBlue">
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:background">@drawable/rounded_corners</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textAllCaps">false</item>

    </style>

    <style name="EdittextStyleWithDescription" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">30dp</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/light_gray</item>
        <item name="android:imeOptions">actionDone</item>
        <item name="android:inputType">text</item>
        <item name="android:maxLength">28</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">@color/gray</item>
        <item name="android:textCursorDrawable">@drawable/cursor</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>